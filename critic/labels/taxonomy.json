 "rule_families": {
  "naming_precise": "A name says exactly what the value holds or the function does: verb-first functions, type suffixes such as *_id and is_*.",
  "project_vocabulary": "Use the project's existing words, one per concept: no coined jargon, synonyms, overloaded or banned words.",
  "owning_layer": "Put code in the module or layer that owns the concept; generic layers carry no app or domain specifics.",
  "reuse_single_source": "Reuse the existing primitive, model or helper, and keep one source of truth and one approach per concept.",
  "no_needless_machinery": "Add no type, wrapper, function, flag, check or special case the goal does not need; prefer the plainest mechanism.",
  "delete_dead_code": "Delete code, fields and branches that nothing reads or can reach, instead of keeping or documenting them.",
  "keep_to_task": "Keep the diff to the ask: unrequested features and unrelated edits go elsewhere, and a small ask gets a small diff.",
  "no_backcompat": "Finish the migration and delete the old path; no compatibility shim or second form.",
  "no_dict_any": "No dict[str, Any] or Any where a model with named fields belongs.",
  "precise_types": "Type precisely: enums for closed sets, named id types, required fields not Optional, exhaustive matches.",
  "fail_loudly_at_boundary": "Validate and resolve at the boundary and raise on bad state; no silent fallback, magic default, broad except or Optional deferral.",
  "model_data_once": "Store each fact once, on the model it describes: no derivable or duplicate fields, opaque ids, declare rather than infer.",
  "prompt_short_true": "LLM-facing text is short and true: each point once, the real purpose stated, nothing the model already knows.",
  "prose_true_minimal": "Docs, comments and PR text say only what is true and needed: no restating code, narrating the edit or overclaiming.",
  "llm_contract": "Derive and enforce in code or schema; ask the LLM only for what code cannot do.",
  "capture_the_rule": "Enforce a recurring rule mechanically (arch test, lint, validation) or write it down; gates guard real invariants and stay unweakened.",
  "honor_decisions": "Do what was asked or agreed, including names the reviewer gave; do not reintroduce what was rejected.",
  "correctness": "Fix the actual bug or its root cause, and handle the cases the input allows.",
  "tests_meaningful": "Tests run everywhere and exercise real behaviour: no skips, trivial or restating tests, or vacuous asserts.",
  "readable_code": "Write code a reader can follow locally: plain control flow, direct expressions, named steps, no unexplained sentinels.",
  "narrow_interfaces": "A function takes the id or value it needs, not paths, whole objects or generic passthroughs.",
  "domain_design_call": "A product, domain or UI design call specific to this feature; not a portable rule.",
  "explain_or_justify": "The reviewer asks what or why; the implied rule is to explain or justify the code.",
  "approval": "Praise, sign-off or acceptance; no rule.",
  "other": "Housekeeping, follow-ups, feature ideas and one-off rules outside the families above."
 },
