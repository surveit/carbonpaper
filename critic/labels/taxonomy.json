{
 "themes": {
  "naming": "A name misdescribes what a value holds or a function does, is vague, lacks a verb, or omits a type suffix (*_id, is_*).",
  "vocabulary": "Coined jargon, a synonym for an existing concept, or an overloaded or banned word where the project already has a word.",
  "code_placement": "Code sits in the wrong module or layer, or a layer knows app or domain concepts it should not.",
  "reinvents_existing": "New code re-implements or duplicates an existing primitive, model, helper or tool.",
  "one_source_of_truth": "One fact, list, rule or approach is kept in two places that must agree.",
  "needless_abstraction": "A new type, wrapper, function, flag, check or special case the goal does not need; a simpler design exists.",
  "dead_code": "Code, fields or branches that nothing reads or can reach.",
  "scope_creep": "The diff carries unrequested features or unrelated edits, or is far bigger than the ask.",
  "backcompat": "A compatibility shim, legacy path or half-finished migration kept instead of a clean migration.",
  "dict_any": "dict[str, Any], Any or an untyped dict where a model with named fields belongs.",
  "weak_types": "Imprecise types: str for a closed set, Optional on a required field, a missing annotation or exhaustive match.",
  "fallback_or_fabrication": "A silent default, fallback, placeholder or made-up value stands in for data or hides a failure.",
  "boundary_validation": "Validation, None-handling or raising is misplaced or missing: Optional deferral, missing guard, soft return, broad except.",
  "data_model": "What a record stores and how: identity, derivable or duplicate fields, one shape versus several, persistence layout.",
  "verbose_prose": "Prose (prompt, tool description, doc, comment) longer than its content needs.",
  "prompt_design": "What LLM-facing text says: role, purpose, procedure, what the model already knows.",
  "llm_contract": "Work given to the LLM, or a rule left in prompt prose, that code or schema should derive or enforce.",
  "prose_accuracy": "Prose states something untrue, overclaims, frames the point wrong, or does not parse.",
  "comments_and_docs": "A comment, docstring or doc restates code, narrates the edit, points elsewhere, sits at the wrong altitude or should not exist.",
  "product_copy": "Wording of user-facing or model-facing product copy, as distinct from its length.",
  "ux_behavior": "What the UI shows or how it behaves; visual encoding choices.",
  "design_direction": "The reviewer rejects, redirects or specifies the design or product behaviour; judging it needs product context.",
  "correctness_bug": "A logic error, missed edge case, unmet real-world requirement, or a workaround instead of the root cause.",
  "tests": "A test is missing, weak, skipped, trivial, circular or restates the code.",
  "gates": "The reviewer asks for a rule to be enforced mechanically or written down, or objects to a gate's design, weakening or evasion.",
  "ignored_feedback": "The agent did not do what was asked or agreed, deferred it, or reintroduced something rejected.",
  "readability": "Code a reader cannot follow locally: roundabout control flow, unexplained sentinels, long functions.",
  "hardcoded_values": "Hardcoded paths, constants, magic values or facts that should be derived or declared once.",
  "interface_shape": "A function or tool takes the wrong inputs: paths instead of ids, whole objects, generic passthroughs.",
  "review_guide": "The PR text or review guide is miscalibrated: wrong or missing decision flags, unflagged concepts.",
  "question_only": "A clarifying question with no correction implied.",
  "praise_or_signoff": "Explicit praise, approval, acceptance or sign-off.",
  "other": "Feature ideas, follow-up requests, housekeeping, performance, security and one-offs."
 },
