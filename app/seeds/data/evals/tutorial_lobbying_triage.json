{
  "eval_id": "alignment_hard_cases",
  "name": "Hard say-versus-do judgments",
  "description": "24 invented filings, most deliberately ambiguous rather than merely hard to read. Each expected label was fixed from Step 3's four definitions before the workflow ran, so a disagreement here is a finding, not a mislabel.",
  "override_stage": "filings_with_commitments",
  "target_stage": "judge_alignment",
  "expected_outputs": [
    {
      "output_column": "ai_judgment",
      "metric": "exact"
    }
  ],
  "table": {
    "path": "app/seeds/data/evals/tutorial_alignment_hard.csv",
    "format": "csv",
    "table_schema": {
      "columns": [
        {
          "name": "filing_id",
          "type": "str",
          "nullable": false
        },
        {
          "name": "client",
          "type": "str",
          "nullable": false
        },
        {
          "name": "registrant",
          "type": "str",
          "nullable": false
        },
        {
          "name": "amount_usd",
          "type": "int",
          "nullable": false
        },
        {
          "name": "filing_period",
          "type": "str",
          "nullable": false
        },
        {
          "name": "lobbied_about",
          "type": "str",
          "nullable": false
        },
        {
          "name": "public_commitment",
          "type": "str",
          "nullable": true
        },
        {
          "name": "commitment_source",
          "type": "str",
          "nullable": true
        },
        {
          "name": "ai_judgment",
          "type": "str",
          "nullable": false,
          "description": "The label Step 3's definitions give this filing, written before the stage ran.",
          "enum": [
            "Contradicts",
            "Matches",
            "Unclear",
            "No commitment given"
          ]
        }
      ]
    }
  }
}
