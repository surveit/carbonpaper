          },
          {
            "name": "benchmark_text",
            "type": "str",
            "nullable": false
          },
          {
            "name": "published_at",
            "type": "date",
            "nullable": false
          }
        ],
        "primary_key": [
          "evidence_id",
          "benchmark_id"
        ]
      }
