  "output_schema": {
    "columns": [
      {
        "name": "evidence_id",
        "type": "str",
        "nullable": false
      },
      {
        "name": "benchmark_id",
        "type": "str",
        "nullable": false
      },
      {
        "name": "entity_id",
        "type": "str",
        "nullable": false
      },
      {
        "name": "query_id",
        "type": "str",
