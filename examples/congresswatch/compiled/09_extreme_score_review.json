  "queue": {
    "filter": "abs(score) == 2 OR precedence_failure == true",
    "hash_columns": [
      "entity_id",
      "query_id",
      "quote"
    ],
    "reviewer_instructions": "Read the quote and the model's score. Confirm or override.\n\nCommon reasons to override:\n  - Quote was taken out of context and the member's actual stance is\n    the opposite.\n  - The \"+2 strong support\" label was applied to a hedged statement\n    that should be +1.\n  - The quote talks about the issue but doesn't actually take a\n    position (downgrade to 0 or reject as precedence_failure).\n  - Press release was reprinting someone else's statement; the\n    member isn't taking that stance themselves.\n",
    "routing": "1-of-1",
    "conflict_resolution": "single_reviewer",
    "estimated_volume_per_week": 50
  },
  "compiler_notes": [
    "hash_columns intentionally include the quote so re-runs with slightly different LLM output don't accidentally reuse decisions."
  ]
}