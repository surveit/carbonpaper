__pycache__/
*.pyc
*.pyo

# Local server / probe logs
*.log

# OS
.DS_Store
Thumbs.db
build/

# The document store (SQLite; app/core/persistence.py) defaults to ~/.carbonpaper/,
# outside the checkout, so nothing here holds it — but CARBON_PAPER_DB_PATH can still
# point a process at data/ inside the tree. Anchored to the repo root (leading /) so it
# doesn't also match a same-named dir elsewhere, e.g. the committed app/seeds/data/
# fixtures.
/data/

# Example methodology content + scratch pipelines. Generated run outputs land
# here, and lint/typecheck skip these dirs (ruff respects .gitignore).
# Already-tracked files under examples/ stay tracked; new files need `git add -f`.
examples/
saydo/

# Local process artifacts — brainstorming specs, plans, spikes, and scratch
# scripts stay on the working machine, not in the repo/PRs.
docs/superpowers/
scripts/
# ...except CI's own scripts, which are part of the repo, not scratch.
!.github/scripts/

# agent chat session scratch (dev-only, never committed)
app/agent/_sessions/

# Agent worktrees: transient scratch, never part of the repo.
.claude/worktrees/
